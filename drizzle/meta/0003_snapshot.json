          "value": "\"order\".\"status\" in ('placed', 'accepted', 'preparing', 'ready', 'picked_up', 'cancelled')"
        },
        "order_pickup_name_chk": {
          "name": "order_pickup_name_chk",
          "value": "char_length(\"order\".\"pickup_name\") between 1 and 40"
        },
        "order_note_chk": {
          "name": "order_note_chk",
          "value": "char_length(\"order\".\"note\") <= 200 and char_length(\"order\".\"allergy_note\") <= 200"
        },
        "order_subtotal_chk": {
          "name": "order_subtotal_chk",
          "value": "\"order\".\"subtotal_cents\" >= 0"
        },
        "order_allergens_chk": {
          "name": "order_allergens_chk",
          "value": "\"order\".\"allergy_allergens\" <@ array['milk', 'egg', 'fish', 'crustacean_shellfish', 'tree_nuts', 'peanuts', 'wheat', 'soy', 'sesame', 'gluten']::text[]"
        },
        "order_allergy_shape_chk": {
          "name": "order_allergy_shape_chk",
          "value": "(\"order\".\"allergy_alert\" and (cardinality(\"order\".\"allergy_allergens\") > 0 or char_length(\"order\".\"allergy_note\") > 0)) or (not \"order\".\"allergy_alert\" and cardinality(\"order\".\"allergy_allergens\") = 0 and \"order\".\"allergy_note\" = '')"
        },
        "order_ack_shape_chk": {
          "name": "order_ack_shape_chk",
          "value": "(\"order\".\"allergy_ack_at\" is null or \"order\".\"allergy_alert\")"
        },
        "order_alert_ack_chk": {
          "name": "order_alert_ack_chk",
          "value": "(not \"order\".\"allergy_alert\" or \"order\".\"allergy_ack_at\" is not null or \"order\".\"status\" in ('placed', 'cancelled'))"
        },
        "order_confirmed_shape_chk": {
          "name": "order_confirmed_shape_chk",
          "value": "(not \"order\".\"allergy_customer_confirmed\" or \"order\".\"allergy_alert\")"
        },
        "order_cancel_reason_chk": {
          "name": "order_cancel_reason_chk",
          "value": "\"order\".\"cancel_reason\" is null or char_length(\"order\".\"cancel_reason\") <= 200"
        }
      },
      "isRLSEnabled": false
    },
